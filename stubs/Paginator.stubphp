<?php

namespace Illuminate\Contracts\Pagination {
    /**
     * Laravel 12 has "(at)method $this through(callable(TValue): mixed $callback)" annotation which for some reason breaks psalm as of 6.13 version.
     *
     * @template TKey of array-key
     * @template-covariant TValue
     */
    interface Paginator
    {
        /** @return array<TKey, TValue> */
        public function items();
    }
}


namespace LaravelDoctrine\ORM\Pagination {
    use Illuminate\Contracts\Pagination\LengthAwarePaginator;

    /**
     * @template T
     */
    class PaginatorAdapter
    {
        /**
         * @return LengthAwarePaginator<array-key, T>
         */
        public function make(): LengthAwarePaginator {}
    }
}
